using Gtk 4.0;
using Adw 1;

template $CalendarRow: Adw.ActionRow {
  activatable: true;
  accessible-role: checkbox;
  styles ["calendar-row"]

  child: Box header_box {
    spacing: 6;

    DrawingArea color_swatch {
      width-request: 16;
      height-request: 16;
      valign: center;
      accessible-role: presentation;
    }

    Label title_label {
      hexpand: true;
      ellipsize: end;
      halign: start;
      valign: center;
    }

    Image checkmark_image {
      icon-name: "checkmark-small-symbolic";
      visible: false;
      valign: center;
      accessible-role: presentation;
    }
  };
}
