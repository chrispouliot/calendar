using Gtk 4.0;
using Adw 1;

template $AgendaView: Adw.Bin {
  ScrolledWindow agenda_scroll {
    hexpand: true;
    vexpand: true;
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    overlay-scrolling: true;

    child: Adw.Clamp agenda_clamp {
      maximum-size: 900;
      tightening-threshold: bind agenda_clamp.maximum-size;
      halign: fill;
      hexpand: true;

      child: Box agenda_days_box {
        orientation: vertical;
        spacing: 16;
        margin-top: 28;
        margin-bottom: 28;
        margin-start: 24;
        margin-end: 24;
        halign: fill;
        hexpand: true;
        vexpand: true;
        css-classes: ["agenda-content"];
      };
    };
  }
}
