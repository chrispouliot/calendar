using Gtk 4.0;
using Adw 1;

template $PreferencesDialog: Adw.Dialog {
  title: "Preferences";
  content-width: 480;
  content-height: 440;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: "Time Format";
        description: "Choose how times are displayed throughout Calendar.";

        Adw.ComboRow time_format_row {
          title: "Clock format";
        }
      }

      Adw.PreferencesGroup {
        title: "Default Reminders";
        description: "Reminder added to new events. Existing events are not changed.";

        Adw.ComboRow timed_reminder_row {
          title: "Timed events";
        }

        Adw.ComboRow all_day_reminder_row {
          title: "All-day events";
        }
      }
    };
  }
}
